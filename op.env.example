# 1Password secret references. These are pointers, not keys.
#
# Copy this file to op.env (which is gitignored) and replace the placeholders
# with the vault, item, and field names of your own 1Password items. The
# scripts then run `op run --env-file=op.env -- ...`, which hands the real
# keys to Inspect as environment variables without writing them to disk.

ANTHROPIC_API_KEY=op://<vault>/<item>/<field>

# Optional: only needed to run an OpenAI model. Delete the line otherwise.
OPENAI_API_KEY=op://<vault>/<item>/<field>
